# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local to Git.
# ==============================================================================


# ------------------------------------------------------------------------------
# 2. Supabase Postgres Configuration (Primary Production Persistence)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Public Supabase URL and Publishable Key (safe for client-side queries permitted by RLS)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Server-only Supabase URL and Secret Key (used strictly by server route handlers)
# NEVER expose SUPABASE_SECRET_KEY to client-side code (never prefix with NEXT_PUBLIC_).
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your_secret_key_here"

# ------------------------------------------------------------------------------
# 3. Resend Email Notifications (Optional but Recommended)
# Get your API key from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="your_resend_api_key_here"

# Where notification emails should be delivered (Chandra's personal address)
CONTACT_TO_EMAIL="sahiljoshi399@gmail.com"

# The sender identity in Resend
# Default sandbox sender: "Portfolio Contact <onboarding@resend.dev>"
# Verified domain sender: "Chandra Shekhar <contact@yourdomain.com>"
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. Instant Webhook Notifications (Optional: Discord / Slack / Telegram)
# ------------------------------------------------------------------------------
# Webhook URL to receive instant alerts when a visitor or recruiter submits an inquiry
CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting Salt
# ------------------------------------------------------------------------------
# Secret salt used to hash visitor IP addresses with SHA-256 before rate limiting
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
IP_HASH_SALT="generate_a_random_32_byte_hex_string_here"

# ------------------------------------------------------------------------------
# 6. Optional: Upstash Redis (For Distributed Serverless Rate Limiting)
# If provided, sliding-window rate limiting is executed via Upstash Redis.
# If omitted, rate limiting uses Supabase/PostgreSQL query counts (5/hour).
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
